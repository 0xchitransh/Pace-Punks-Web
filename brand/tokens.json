{
  "name": "Pace Punks",
  "version": "1.0",
  "color": {
    "night":      { "value": "#140F33", "use": "Page/app background. Deep indigo from the night-city backgrounds." },
    "night-2":    { "value": "#1E1749", "use": "Raised surfaces: cards, sheets, tab bar." },
    "night-3":    { "value": "#2A2163", "use": "Hover/pressed surfaces, input fields." },
    "line":       { "value": "#3B3180", "use": "Borders and dividers (1px or 2px pixel borders)." },
    "cream":      { "value": "#FFF3DE", "use": "Primary text and the logo letters. Sneaker-leather cream, not pure white." },
    "cream-dim":  { "value": "#BDB3D9", "use": "Secondary text on night." },
    "sunset":     { "value": "#FF7A3D", "use": "Primary accent: main buttons, 'PUNKS' in the wordmark, active states." },
    "neon-pink":  { "value": "#FF4FA3", "use": "Pixel drop-shadow on logo and buttons, highlights, Pace Box." },
    "aqua-pulse": { "value": "#3EE6D2", "use": "Activity/verified movement, progress bars, success." },
    "gold":       { "value": "#FFC93D", "use": "XP, levels, rewards (GP)." },
    "danger":     { "value": "#FF5A5A", "use": "Errors, low durability." }
  },
  "gradient": {
    "sunset-run": "linear-gradient(180deg, #2A2163 0%, #7A2E7E 55%, #FF7A3D 100%)"
  },
  "font": {
    "display": { "family": "Pixelify Sans", "weights": [500, 700], "source": "Google Fonts", "use": "Headlines and big numbers only." },
    "label":   { "family": "Silkscreen", "weights": [400, 700], "source": "Google Fonts", "use": "Small uppercase labels, chips, stat names, button text. Letter-spacing 0.04em." },
    "body":    { "family": "Sora", "weights": [400, 600], "source": "Google Fonts", "use": "Body copy, forms, UI text." }
  },
  "radius": { "none": 0, "sm": 4, "md": 8, "app-icon": "platform default" },
  "shadow": { "pixel": "4px 4px 0 #FF4FA3", "pixel-sm": "2px 2px 0 #FF4FA3", "pixel-dark": "4px 4px 0 #0B0820" },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "attributes": {
    "Efficiency": "#FF7A3D",
    "Stamina":    "#3EE6D2",
    "Resilience": "#8C7CFF",
    "Momentum":   "#FF4FA3",
    "Focus":      "#FFC93D"
  }
}
